if __name__ == '__main__':
    students = []

    for i in range(int(input())):
        name = input()
        score = float(input())
        students.append([name, score])

    scores = []

    for student in students:
        scores.append(student[1])

    scores = list(set(scores))
    scores.sort()

    second = scores[1]

    names = []

    for student in students:
        if student[1] == second:
            names.append(student[0])

    names.sort()

    for name in names:
        print(name)
